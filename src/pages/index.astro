---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { menuItems, photos } from "../data/photos";
import { site } from "../data/site";
import { photoSrc, withBase } from "../lib/url";

const label = (file: string) => file.replace(".jpg", "");
---

<Base>
  <Header />
  <main>
    <section class="hero" id="top">
      <img src={photoSrc(photos.hero)} alt={label(photos.hero)} />
      <p class="hours-chip">
        <strong>Open daily</strong>
        10 AM–1 AM
      </p>
      <div class="hero-copy">
        <p class="kicker">Panjer · Denpasar</p>
        <h1>Come for coffee.<br />Stay for the moment.</h1>
        <p>Thoughtfully brewed, warmly served. Your next hangout spot in Bali.</p>
        <div class="hero-actions">
          <a class="pill light" href={withBase("menu")}>Explore the menu</a>
          <a class="pill ghost" href={withBase("#visit")}>Find us</a>
        </div>
      </div>
    </section>

    <section class="section story" id="story">
      <div class="wrap inner">
        <p class="kicker">Coffee · Hangout · Bali</p>
        <h2>Your next hangout spot in Bali.</h2>
        <p>Coffee lovers, get ready.</p>
        <p>
          Where good coffee meets great moments. Thoughtfully brewed, warmly served, on
          Jalan Tukad Barito No. 16.
        </p>
      </div>
    </section>

    <section class="section feature">
      <div class="wrap split">
        <div>
          <p class="kicker">The coffee</p>
          <h2>Thoughtfully brewed. Warmly served.</h2>
          <p>A latte, a Mont Blanc, and a room to stay in.</p>
          <a class="text-link" href={withBase("menu")}>See the menu →</a>
        </div>
        <img src={photoSrc(photos.coffee)} alt={label(photos.coffee)} />
      </div>
    </section>

    <section class="section" id="menu">
      <div class="wrap">
        <div class="menu-head">
          <div>
            <p class="kicker">From the kitchen</p>
            <h2>From the menu.</h2>
          </div>
          <a class="text-link" href={withBase("menu")}>Full menu →</a>
        </div>
        <div class="cards">
          {
            menuItems.map((item) => (
              <figure class="card">
                <img src={photoSrc(item.file)} alt={item.name} />
                <figcaption>
                  <span class="card-line">
                    <span class="card-name">{item.name}</span>
                    <span class="card-price">{item.price}</span>
                  </span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <section class="team">
      <img src={photoSrc(photos.team)} alt={label(photos.team)} />
      <div class="inner">
        <p class="kicker">The people</p>
        <h2>Come as you are.</h2>
      </div>
    </section>

    <section class="section" id="gallery">
      <div class="wrap">
        <p class="kicker">Inside</p>
        <h2 class="center-head" style="font-size:clamp(2.4rem,4vw,3.8rem);margin-bottom:1.5rem;">
          Easy hours, open door.
        </h2>
        <div class="gallery-grid">
          {photos.gallery.map((file) => <img src={photoSrc(file)} alt={label(file)} />)}
        </div>
      </div>
    </section>

    <section class="section hospitality">
      <div class="wrap split reverse">
        <img src={photoSrc(photos.hospitality)} alt={label(photos.hospitality)} />
        <div class="copy">
          <p class="kicker">Stay a while</p>
          <h2>A place to hang out.</h2>
          <p>
            Grab a coffee, meet someone, or settle in. The room is open daily from 10.00 AM
            to 01.00 AM.
          </p>
          <a class="text-link" href={site.instagram}>Follow {site.handle} →</a>
        </div>
      </div>
    </section>

    <section class="section visit" id="visit">
      <div class="wrap split">
        <div>
          <p class="kicker">Visit us</p>
          <h2>Panjer, Denpasar.</h2>
          <div class="visit-meta">
            <p><strong>{site.hours}</strong></p>
            {site.addressLines.map((line) => <p>{line}</p>)}
          </div>
          <div class="visit-actions">
            <a class="pill line" href={site.maps}>Google Maps</a>
            <a class="pill line" href={site.instagram}>Instagram</a>
          </div>
        </div>
        <img src={photoSrc(photos.visit)} alt={label(photos.visit)} />
      </div>
    </section>
  </main>
  <Footer />
</Base>
